        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    pelanggan {\n        INT id_pelanggan PK\n        VARCHAR nama_pelanggan\n        VARCHAR email\n        VARCHAR no_hp \&quot;pribadi\&quot;\n        VARCHAR password\n        VARCHAR alamat_utama\n    }\n    \n    produk {\n        INT id_produk PK\n        VARCHAR nama_produk\n        VARCHAR kategori\n        DECIMAL harga_master\n        INT stok \&quot;CHECK &gt;= 0\&quot;\n        FLOAT berat\n    }\n    \n    pesanan {\n        INT id_pesanan PK\n        DATETIME tgl_pesan\n        INT id_pelanggan FK\n        VARCHAR status_pesanan\n        VARCHAR alamat_pengiriman\n        DECIMAL ongkos_kirim\n    }\n    \n    detail_pesanan {\n        INT id_pesanan PK,FK\n        INT id_produk PK,FK\n        INT qty\n        DECIMAL harga_saat_pesan\n    }\n    \n    pembayaran {\n        INT id_pembayaran PK\n        INT id_pesanan FK\n        VARCHAR metode\n        DECIMAL jumlah_bayar\n        DATETIME tgl_bayar\n    }\n    \n    pengiriman {\n        INT id_pengiriman PK\n        INT id_pesanan FK\n        VARCHAR no_resi\n        VARCHAR kurir_ekspedisi\n        VARCHAR status_kirim\n    }\n\n    pelanggan ||--o{ pesanan : \&quot;melakukan (AB-01)\&quot;\n    pesanan ||--|{ detail_pesanan : \&quot;berisi (AB-05)\&quot;\n    produk ||--o{ detail_pesanan : \&quot;tercantum di (AB-03)\&quot;\n    pesanan ||--o| pembayaran : \&quot;memiliki (AB-07)\&quot;\n    pesanan ||--o| pengiriman : \&quot;memiliki (AB-08)\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="7MM3_31h6aDZbTlePCDe-1">
